<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
      <groupId>com.codenameone</groupId>
      <artifactId>cn1-bluetooth</artifactId>
      <version>1.0.2</version>
  </parent>
  <groupId>com.codenameone</groupId>
  <artifactId>cn1-bluetooth-javase</artifactId>
  <version>1.0.2</version>

  <name>cn1-bluetooth-javase</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>


  </properties>

  <dependencies>
      <dependency>
          <groupId>com.codenameone</groupId>
          <artifactId>codenameone-javase</artifactId>
          <scope>provided</scope>
      </dependency>
      <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>${cn1lib.name}-common</artifactId>
          <version>${project.version}</version>
      </dependency>

  </dependencies>

  <profiles>
    <!-- The NativeBleBackend is a Rust binary built from src/main/rust/cn1-ble-helper
         that wraps the btleplug crate (CoreBluetooth on macOS, BlueZ on Linux,
         WinRT on Windows). Each OS-activated profile builds the helper with cargo
         and copies it under the matching com/codename1/bluetoothle/native/<os>/
         resource folder so NativeBleBackend.helperResourcePath() can find it at
         runtime. Builds on OSes other than these three (or where cargo is
         missing) silently skip: NativeBleBackend.isAvailable() returns false and
         BluetoothNativeBridgeImpl falls back to the simulator. -->

    <profile>
      <id>macos-native-ble-helper</id>
      <activation>
        <os><family>mac</family></os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>build-cn1-ble-helper-macos</id>
                <phase>process-classes</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <echo message="Building cn1-ble-helper (Rust + btleplug, macOS)"/>
                    <exec executable="cargo"
                          dir="${project.basedir}/src/main/rust/cn1-ble-helper"
                          failonerror="true">
                      <arg value="build"/>
                      <arg value="--release"/>
                    </exec>
                    <mkdir dir="${project.build.outputDirectory}/com/codename1/bluetoothle/native/macos"/>
                    <copy file="${project.basedir}/src/main/rust/cn1-ble-helper/target/release/cn1-ble-helper"
                          tofile="${project.build.outputDirectory}/com/codename1/bluetoothle/native/macos/cn1-ble-helper"
                          overwrite="true"/>
                    <chmod file="${project.build.outputDirectory}/com/codename1/bluetoothle/native/macos/cn1-ble-helper"
                           perm="755"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>linux-native-ble-helper</id>
      <activation>
        <os><family>unix</family><name>Linux</name></os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>build-cn1-ble-helper-linux</id>
                <phase>process-classes</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <echo message="Building cn1-ble-helper (Rust + btleplug, Linux)"/>
                    <exec executable="cargo"
                          dir="${project.basedir}/src/main/rust/cn1-ble-helper"
                          failonerror="true">
                      <arg value="build"/>
                      <arg value="--release"/>
                    </exec>
                    <mkdir dir="${project.build.outputDirectory}/com/codename1/bluetoothle/native/linux"/>
                    <copy file="${project.basedir}/src/main/rust/cn1-ble-helper/target/release/cn1-ble-helper"
                          tofile="${project.build.outputDirectory}/com/codename1/bluetoothle/native/linux/cn1-ble-helper"
                          overwrite="true"/>
                    <chmod file="${project.build.outputDirectory}/com/codename1/bluetoothle/native/linux/cn1-ble-helper"
                           perm="755"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>windows-native-ble-helper</id>
      <activation>
        <os><family>windows</family></os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>build-cn1-ble-helper-windows</id>
                <phase>process-classes</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <echo message="Building cn1-ble-helper (Rust + btleplug, Windows)"/>
                    <exec executable="cargo"
                          dir="${project.basedir}/src/main/rust/cn1-ble-helper"
                          failonerror="true">
                      <arg value="build"/>
                      <arg value="--release"/>
                    </exec>
                    <mkdir dir="${project.build.outputDirectory}/com/codename1/bluetoothle/native/windows"/>
                    <copy file="${project.basedir}/src/main/rust/cn1-ble-helper/target/release/cn1-ble-helper.exe"
                          tofile="${project.build.outputDirectory}/com/codename1/bluetoothle/native/windows/cn1-ble-helper.exe"
                          overwrite="true"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

  </profiles>

</project>
